# Runtime — Trevra supports PostgreSQL only.
NODE_ENV=development
PORT=43887
APP_ORIGIN=http://localhost:43173,http://localhost:43887
DATABASE_URL=postgresql://trevra:trevra-local-password@localhost:45432/trevra
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_APPLICATION_NAME=trevra
AUTOMATION_INTERVAL_MS=60000
COOKIE_SECURE=false

# Application authentication (Better Auth uses the same PostgreSQL server).
# Production: generate at least 32 random bytes, e.g. `openssl rand -base64 48`
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:43173
AUTH_DATABASE_POOL_MAX=5
# Google OAuth web application credentials.
# Local callback: http://localhost:43173/api/auth/callback/google
# Production callback: https://your-domain.example/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional structured contract extraction. Without this, Trevra uses its deterministic parser.
OPENAI_API_KEY=
OPENAI_EXTRACTION_MODEL=gpt-5-mini

# Product integrations: Nango Cloud or a self-hosted Nango deployment.
# NANGO_HOST is the server-to-server endpoint. NANGO_PUBLIC_SERVER_URL must be browser-reachable.
NANGO_HOST=http://localhost:43003
NANGO_PUBLIC_SERVER_URL=http://localhost:43003
NANGO_API_KEY=
NANGO_WEBHOOK_SIGNING_KEY=

# Nango integration identifiers.
NANGO_GMAIL_INTEGRATION=trevra-gmail
NANGO_GOOGLE_CALENDAR_INTEGRATION=trevra-google-calendar
NANGO_MICROSOFT_INTEGRATION=trevra-microsoft
NANGO_QUICKBOOKS_INTEGRATION=trevra-quickbooks
NANGO_XERO_INTEGRATION=trevra-xero
NANGO_STRIPE_INTEGRATION=trevra-stripe
NANGO_HONEYBOOK_INTEGRATION=trevra-honeybook
NANGO_BONSAI_INTEGRATION=trevra-bonsai

# Comma-separated Nango sync function names for each provider.
NANGO_SYNCS_GMAIL=trevra-messages
NANGO_SYNCS_GOOGLE_CALENDAR=trevra-meetings
NANGO_SYNCS_MICROSOFT=trevra-messages,trevra-meetings
NANGO_SYNCS_QUICKBOOKS=trevra-invoices,trevra-payments
NANGO_SYNCS_XERO=trevra-invoices,trevra-payments
NANGO_SYNCS_STRIPE=trevra-invoices,trevra-payments
NANGO_SYNCS_HONEYBOOK=trevra-opportunities,trevra-contracts,trevra-milestones
NANGO_SYNCS_BONSAI=trevra-opportunities,trevra-contracts,trevra-milestones

NANGO_ACTION_CREATE_INVOICE=trevra-create-invoice
NANGO_ACTION_CREATE_CHANGE_ORDER=trevra-create-change-order

# Stripe event verification. Required only when receiving direct Stripe webhooks.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional trusted canonical event ingestion from private internal systems.
INGEST_API_KEY=replace-with-a-long-random-value

# Development-only switches. Production validation rejects true values.
ALLOW_DEMO_AUTH=false
ALLOW_SIMULATED_EXECUTION=false
