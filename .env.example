# Runtime — Trevra supports PostgreSQL only.
NODE_ENV=development
PORT=43887
APP_ORIGIN=http://localhost:43173,http://localhost:43887
DATABASE_URL=postgresql://trevra:trevra-local-password@localhost:45432/trevra
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_APPLICATION_NAME=trevra
AUTOMATION_INTERVAL_MS=60000
COOKIE_SECURE=false

# Application authentication (Better Auth uses the same PostgreSQL server).
# Production: generate at least 32 random bytes, e.g. `openssl rand -base64 48`
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:43173
AUTH_DATABASE_POOL_MAX=5
# Google OAuth web application credentials.
# Local callback: http://localhost:43173/api/auth/callback/google
# Production callback: https://your-domain.example/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public discoverability, support, and privacy-preserving traction.
PUBLIC_SITE_URL=http://localhost:43173
PUBLIC_SITE_NAME=Trevra
PUBLIC_SITE_TITLE=Open-source operating system for agent-run GTM | Trevra
PUBLIC_SITE_DESCRIPTION=Trevra gives Claude Code and Codex modular GTM skills, a shared revenue ledger, and approval-gated execution.
PUBLIC_LEGAL_NAME=Trevra
PUBLIC_SUPPORT_EMAIL=support@trevra.local
SECURITY_CONTACT_EMAIL=security@trevra.local
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
MARKETING_HASH_SALT=replace-with-at-least-32-random-characters
TRACTION_ADMIN_TOKEN=replace-with-at-least-32-random-characters
TREVRA_AGENT_TOKEN_PEPPER=replace-with-at-least-32-random-characters
TREVRA_ORCHESTRATOR=postgres
TEMPORAL_ADDRESS=localhost:47233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=trevra-playbooks
TEMPORAL_TLS=false
TEMPORAL_API_KEY=
PUBLIC_REGISTRY_API_URL=http://localhost:43887
PUBLIC_REGISTRY_CORS_ORIGIN=http://localhost:43173
TREVRA_SANDBOX_GATEWAY_URL=
TREVRA_SANDBOX_GATEWAY_TOKEN=
# JSON array of HTTPS approved action adapters. tokenEnv should normally be TREVRA_REMOTE_ACTION_ADAPTER_TOKEN.
TREVRA_REMOTE_ACTION_ADAPTERS_JSON=[]
TREVRA_REMOTE_ACTION_ADAPTER_TOKEN=
TREVRA_CONTAINER_RUNTIME=docker
TREVRA_WASI_RUNTIME=wasmtime
INDEXNOW_KEY=replace-with-8-to-128-url-safe-characters
INDEXNOW_ENDPOINT=https://api.indexnow.org/indexnow

# Optional structured contract extraction. Without this, Trevra uses its deterministic parser.
OPENAI_API_KEY=
OPENAI_EXTRACTION_MODEL=gpt-5-mini

# Product integrations: Nango Cloud or a self-hosted Nango deployment.
# NANGO_HOST is the server-to-server endpoint. NANGO_PUBLIC_SERVER_URL must be browser-reachable.
NANGO_HOST=http://localhost:43003
NANGO_PUBLIC_SERVER_URL=http://localhost:43003
NANGO_API_KEY=
NANGO_WEBHOOK_SIGNING_KEY=

# Nango integration identifiers.
NANGO_GMAIL_INTEGRATION=trevra-gmail
NANGO_GOOGLE_CALENDAR_INTEGRATION=trevra-google-calendar
NANGO_MICROSOFT_INTEGRATION=trevra-microsoft
NANGO_QUICKBOOKS_INTEGRATION=trevra-quickbooks
NANGO_XERO_INTEGRATION=trevra-xero
NANGO_STRIPE_INTEGRATION=trevra-stripe
NANGO_HONEYBOOK_INTEGRATION=trevra-honeybook
NANGO_BONSAI_INTEGRATION=trevra-bonsai
# CRM and prospecting sources. HubSpot and Attio use OAuth. Exa authenticates with an API key that
# the operator types into the Nango Connect UI; the key is posted from the browser to Nango and
# stored there, so Trevra only ever holds the resulting connection reference.
# There is no Apollo entry on purpose: Apollo's terms forbid integrating their API with another
# product. See the comment above `catalog` in src/server/integration-service.ts.
NANGO_HUBSPOT_INTEGRATION=trevra-hubspot
NANGO_ATTIO_INTEGRATION=trevra-attio
NANGO_EXA_INTEGRATION=trevra-exa

# Comma-separated Nango sync function names for each provider.
NANGO_SYNCS_GMAIL=trevra-messages
NANGO_SYNCS_GOOGLE_CALENDAR=trevra-meetings
NANGO_SYNCS_MICROSOFT=trevra-messages,trevra-meetings
NANGO_SYNCS_QUICKBOOKS=trevra-invoices,trevra-payments
NANGO_SYNCS_XERO=trevra-invoices,trevra-payments
NANGO_SYNCS_STRIPE=trevra-invoices,trevra-payments
NANGO_SYNCS_HONEYBOOK=trevra-opportunities,trevra-contracts,trevra-milestones
NANGO_SYNCS_BONSAI=trevra-opportunities,trevra-contracts,trevra-milestones
# HubSpot and Attio are read-only in Trevra: CRM records flow into the ledger and nothing is written
# back. Point these at syncs you deploy that emit Trevra canonical records (deals map to
# trevra-opportunities, logged emails and notes map to trevra-messages).
NANGO_SYNCS_HUBSPOT=trevra-opportunities,trevra-messages
NANGO_SYNCS_ATTIO=trevra-opportunities,trevra-messages
# Exa is queried on demand through the Nango proxy and ships no scheduled sync. Leave empty unless
# you deploy one; "Sync now" reports that none are configured.
NANGO_SYNCS_EXA=

NANGO_ACTION_CREATE_INVOICE=trevra-create-invoice
NANGO_ACTION_CREATE_CHANGE_ORDER=trevra-create-change-order

# Stripe event verification. Required only when receiving direct Stripe webhooks.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional trusted canonical event ingestion from private internal systems.
INGEST_API_KEY=replace-with-a-long-random-value

# Development-only switches. Production validation rejects true values.
ALLOW_DEMO_AUTH=false
ALLOW_SIMULATED_EXECUTION=false
