# Runtime — Trevra supports PostgreSQL only.
NODE_ENV=development
PORT=43887
APP_ORIGIN=http://localhost:43173,http://localhost:43887
DATABASE_URL=postgresql://trevra:trevra-local-password@localhost:45432/trevra
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=30000
# Log the holder of any pooled connection kept longer than this. 0 disables.
DATABASE_POOL_CHECKOUT_WARN_MS=15000
DATABASE_APPLICATION_NAME=trevra
# Migrations. Unset means: apply on boot locally, verify-and-refuse when
# TREVRA_DEPLOYMENT_MODE=hosted (where `npm run db:migrate` is the job instead).
# DATABASE_AUTO_MIGRATE=true
DATABASE_MIGRATION_LOCK_TIMEOUT_MS=10000
DATABASE_MIGRATION_LOCK_WAIT_MS=120000
AUTOMATION_INTERVAL_MS=60000
# Multi-tenant automation sweep: tenants run at once, tenants considered per
# tick, and the budget for starting them. Workers lease each tenant, so several
# may run this loop against one database.
TREVRA_AUTOMATION_CONCURRENCY=4
TREVRA_AUTOMATION_BATCH=100
TREVRA_AUTOMATION_BUDGET_MS=45000
COOKIE_SECURE=false

# Application authentication (Better Auth uses the same PostgreSQL server).
# Production: generate at least 32 random bytes, e.g. `openssl rand -base64 48`
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:43173
AUTH_DATABASE_POOL_MAX=5
# Google OAuth web application credentials.
# Local callback: http://localhost:43173/api/auth/callback/google
# Production callback: https://your-domain.example/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public discoverability, support, and privacy-preserving traction.
PUBLIC_SITE_URL=http://localhost:43173
PUBLIC_SITE_NAME=Trevra
PUBLIC_SITE_TITLE=Open-source operating system for agent-run GTM | Trevra
PUBLIC_SITE_DESCRIPTION=Trevra gives Claude Code and Codex modular GTM skills, a shared revenue ledger, and approval-gated execution.
PUBLIC_LEGAL_NAME=Trevra
PUBLIC_SUPPORT_EMAIL=support@trevra.local
SECURITY_CONTACT_EMAIL=security@trevra.local
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
MARKETING_HASH_SALT=replace-with-at-least-32-random-characters
TRACTION_ADMIN_TOKEN=replace-with-at-least-32-random-characters
TREVRA_AGENT_TOKEN_PEPPER=replace-with-at-least-32-random-characters
# Encrypts workspace model API keys (BYOK), LinkedIn and Reddit credentials at rest.
# Generate with `openssl rand -base64 32`.
#
# REQUIRED when TREVRA_DEPLOYMENT_MODE=hosted -- the server refuses to boot without
# it, because a hosted deployment with no key cannot store a credential at all while
# the setup screen still reads green. Optional locally, where a self-hoster drives a
# browser they signed in by hand and may run without BYOK.
#
# Each sealed row is bound to its own identity (workspace, seat, kind) and encrypted
# under a key derived per workspace, so a ciphertext copied into another tenant's row
# no longer decrypts. Lose or change the key and every stored secret is unrecoverable.
TREVRA_SECRETS_KEY=
# Read-only second key, for rotating TREVRA_SECRETS_KEY without downtime. Empty normally.
# Rotate: 1) set PREVIOUS to the current key and TREVRA_SECRETS_KEY to a new one, deploy --
# old rows still decrypt, new writes use the new key; 2) re-save every stored key in the
# background to re-encrypt it; 3) clear PREVIOUS and deploy again. No migration, no downtime.
# Must be 32 bytes base64 like the key above: a malformed value fails loudly, it is not ignored.
TREVRA_SECRETS_KEY_PREVIOUS=
# Allow the hosted agent's model endpoint to be a private/loopback address, for a
# self-hosted Ollama, vLLM or LiteLLM Proxy. Leave false on a shared deployment:
# it is what stops a workspace pointing the agent at cloud instance metadata.
TREVRA_ALLOW_PRIVATE_MODEL_HOSTS=false
TREVRA_ORCHESTRATOR=postgres
TEMPORAL_ADDRESS=localhost:47233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=trevra-playbooks
TEMPORAL_TLS=false
TEMPORAL_API_KEY=
PUBLIC_REGISTRY_API_URL=http://localhost:43887
PUBLIC_REGISTRY_CORS_ORIGIN=http://localhost:43173
TREVRA_SANDBOX_GATEWAY_URL=
TREVRA_SANDBOX_GATEWAY_TOKEN=
# JSON array of HTTPS approved action adapters. tokenEnv should normally be TREVRA_REMOTE_ACTION_ADAPTER_TOKEN.
TREVRA_REMOTE_ACTION_ADAPTERS_JSON=[]
TREVRA_REMOTE_ACTION_ADAPTER_TOKEN=
TREVRA_CONTAINER_RUNTIME=docker
TREVRA_WASI_RUNTIME=wasmtime
INDEXNOW_KEY=replace-with-8-to-128-url-safe-characters
INDEXNOW_ENDPOINT=https://api.indexnow.org/indexnow

# Optional structured contract extraction. Without this, Trevra uses its deterministic parser.
OPENAI_API_KEY=
OPENAI_EXTRACTION_MODEL=gpt-5-mini

# Company search for lead sourcing (gtm.source-leads). THIS is the key Exa search reads --
# src/server/research/providers/exa.ts takes it from the environment, not from the Nango
# connection below. Connecting Exa in Setup stores a key in Nango that nothing currently uses;
# until that is wired, this variable is the only switch. Empty means the provider reports
# 'needs-credential' and sourcing falls back to the credential-free 'seed' provider.
# Exa results are held in memory and never written to the ledger -- see the header of exa.ts.
EXA_API_KEY=

# Optional deployment-owned HTTP lead-source adapters. Workspaces may select a
# registered key but cannot supply endpoints or secret names. This keeps Trevra
# source-agnostic while allowing an internal intelligence service to plug in.
# Example:
# TREVRA_SOURCE_HTTP_PROVIDERS_JSON=[{"key":"internal-intel","name":"Internal intelligence","endpoint":"https://intel.example.com/candidates","tokenEnv":"INTERNAL_SOURCE_TOKEN","retention":"default"}]
TREVRA_SOURCE_HTTP_PROVIDERS_JSON=[]
# INTERNAL_SOURCE_TOKEN=

# Product integrations: Nango Cloud or a self-hosted Nango deployment.
# NANGO_HOST is the server-to-server endpoint. NANGO_PUBLIC_SERVER_URL must be browser-reachable.
NANGO_HOST=http://localhost:43003
NANGO_PUBLIC_SERVER_URL=http://localhost:43003
NANGO_API_KEY=
NANGO_WEBHOOK_SIGNING_KEY=

# Nango integration identifiers.
NANGO_GMAIL_INTEGRATION=trevra-gmail
NANGO_GOOGLE_CALENDAR_INTEGRATION=trevra-google-calendar
NANGO_MICROSOFT_INTEGRATION=trevra-microsoft
NANGO_QUICKBOOKS_INTEGRATION=trevra-quickbooks
NANGO_XERO_INTEGRATION=trevra-xero
NANGO_STRIPE_INTEGRATION=trevra-stripe
NANGO_HONEYBOOK_INTEGRATION=trevra-honeybook
NANGO_BONSAI_INTEGRATION=trevra-bonsai
# CRM and prospecting sources. HubSpot and Attio use OAuth. Exa authenticates with an API key that
# the operator types into the Nango Connect UI; the key is posted from the browser to Nango and
# stored there, so Trevra only ever holds the resulting connection reference.
# KNOWN GAP: that stored key is not what Exa search reads today -- set EXA_API_KEY above instead.
# The connection is kept because it is the shape a hosted, per-workspace key will need.
# There is no Apollo entry on purpose: Apollo's terms forbid integrating their API with another
# product. See the comment above `catalog` in src/server/integration-service.ts.
NANGO_HUBSPOT_INTEGRATION=trevra-hubspot
NANGO_ATTIO_INTEGRATION=trevra-attio
NANGO_EXA_INTEGRATION=trevra-exa

# Comma-separated Nango sync function names for each provider.
# KNOWN GAP: there is no canonical 'meeting' record kind, so every record a 'trevra-meetings'
# sync returns is counted and dropped rather than stored. The sync now reports the count on the
# connection instead of failing silently; leave these empty unless you are building that kind.
NANGO_SYNCS_GMAIL=trevra-messages
NANGO_SYNCS_GOOGLE_CALENDAR=trevra-meetings
NANGO_SYNCS_MICROSOFT=trevra-messages,trevra-meetings
NANGO_SYNCS_QUICKBOOKS=trevra-invoices,trevra-payments
NANGO_SYNCS_XERO=trevra-invoices,trevra-payments
NANGO_SYNCS_STRIPE=trevra-invoices,trevra-payments
NANGO_SYNCS_HONEYBOOK=trevra-opportunities,trevra-contracts,trevra-milestones
NANGO_SYNCS_BONSAI=trevra-opportunities,trevra-contracts,trevra-milestones
# HubSpot and Attio are read-only in Trevra: CRM records flow into the ledger and nothing is written
# back. Point these at syncs you deploy that emit Trevra canonical records (deals map to
# trevra-opportunities, logged emails and notes map to trevra-messages).
NANGO_SYNCS_HUBSPOT=trevra-opportunities,trevra-messages
NANGO_SYNCS_ATTIO=trevra-opportunities,trevra-messages
# Exa is queried on demand through the Nango proxy and ships no scheduled sync. Leave empty unless
# you deploy one; "Sync now" reports that none are configured.
NANGO_SYNCS_EXA=

# Trevra intentionally has no customer-finance actions or generic event-ingest secret.

# Development-only switches. Production validation rejects true values.
ALLOW_DEMO_AUTH=false
ALLOW_SIMULATED_EXECUTION=false

# What kind of deployment this is: local | hosted.
#
# 'hosted' is the ONE unconditional gate on LinkedIn automation. A hosted,
# multi-tenant Trevra taking custody of one human's LinkedIn session is the
# exposure the whole design avoids, so nothing below can turn it back on -- and
# it also refuses to store a LinkedIn password at all, whatever anyone asks.
#
# REQUIRED IN PRODUCTION, and named rather than defaulted: the old default was
# 'local', so a hosted box that simply forgot this line came up with the browser
# workers live, the shared browser-profile paths live, and the operator-wide CLI
# backend no longer refusing. Guessing that one wrong is a cross-tenant incident,
# so production now refuses to start until this says which kind of box it is.
TREVRA_DEPLOYMENT_MODE=local

# LinkedIn automation. ON by default outside hosted mode, because the only
# deployment that can use it is a self-hoster automating their own account on
# their own machine. Set to false to switch it off; there is nothing to set to
# switch it on.
#
# TWO WAYS TO SIGN A SEAT IN, and you choose per seat on the seat screen:
#
#   manual        THE ZERO-CUSTODY PATH, and the default for a fresh seat. The
#                 browser runs on YOUR machine and you log into it by hand, in a
#                 real Chrome window, 2FA included. Trevra stores no password
#                 and no cookie. From the host, against the Postgres your stack
#                 already publishes on TREVRA_DB_PORT (default 45432):
#
#                   npm run linkedin:login     open the window and sign in, once
#                   npm run linkedin:worker    run the sending loop and fulfil detection
#
#   credentials   YOUR OWN email and password, saved once, AES-256-GCM sealed
#                 with TREVRA_SECRETS_KEY above. Trevra then signs in headlessly
#                 from the container -- nothing to run and nothing on your
#                 machine, which is the only way this works where there is no
#                 display to show a login window on. A stored session is always
#                 reused first; the password is opened only when it has expired.
#                 It is never returned by any route, never logged, and never put
#                 in an error message.
#
# See docs/linkedin-outreach-plan.md 4.1 and 4.9.
TREVRA_LINKEDIN_LOCAL=true

# MAY THIS PROCESS OPEN A BROWSER NOBODY CAN SEE? Default true.
#
# Set false on the CONTAINER in a stack where you run `npm run linkedin:worker`
# on your own machine. The container has a headless Chromium for other features
# and will otherwise take the seat first -- driving your account from a GPU-less
# container whose WebGL reports SwiftShader, from the container's IP, while your
# headed worker sits idle. False parks the work for the machine with a display.
#
# It is NOT an off switch for the feature (that is TREVRA_LINKEDIN_LOCAL): the
# queue, the ledger, the routes and the "run the worker on your machine" 202 all
# carry on unchanged.
TREVRA_LINKEDIN_HEADLESS=true

# The Chrome profile that window signs into. Default ~/.trevra/linkedin-profile,
# resolved by whichever process launches the browser -- $HOME belongs to it, not
# to this file.
TREVRA_LINKEDIN_PROFILE_DIR=

# ---------------------------------------------------------------------------
# The local Reddit worker, on exactly the terms above.
#
# A SEPARATE SWITCH, not a second use of the LinkedIn one: the two workers sign
# into two different accounts, keep two different browser profiles, and get
# banned independently, so wanting one without the other has to be sayable.
# TREVRA_DEPLOYMENT_MODE=hosted overrides this to off unconditionally.
#
# WHAT IT DRIVES: signing in, reading a subreddit, and posting one comment the
# operator wrote in one thread the operator chose. It does NOT submit posts --
# that stays prepare-only, because an unattended submission into a subreddit
# whose sidebar nobody read is a shadowban risk for the account and the domain.
TREVRA_REDDIT_LOCAL=true

# The Chrome profile Reddit signs into. Default ~/.trevra/reddit-profile, and it
# MUST NOT be the LinkedIn one: a persistent user-data-dir holds one signed-in
# Chrome at a time, and pointing both workers at the same directory has them
# fight over the profile lock.
TREVRA_REDDIT_PROFILE_DIR=

# ---------------------------------------------------------------------------
# Lead sourcing: turn a LinkedIn people-search URL or a post URL into a list of
# people the campaign builder can pull targets from.
#
# A SEPARATE OPT-IN FROM SENDING, AND OFF UNLESS SET. Everything above
# automates YOUR OWN account. Reading other people's profiles out of a search
# results page is scraping under LinkedIn's User Agreement 8.2 -- a different
# act with different contractual exposure, landing on the account you signed
# in with. TREVRA_DEPLOYMENT_MODE=hosted overrides this to off unconditionally,
# because no hosted operator can accept that on a tenant's behalf.
#
# With it off, Outreach -> Leads still lists whatever earlier walks stored; only
# queueing a new walk is refused, and the campaign builder's "Pull from lead
# sourcing" shows the refusal verbatim instead of a picker.
TREVRA_LINKEDIN_LEAD_SOURCING=false

# ---------------------------------------------------------------------------
# Run the hosted agent through a local CLI you are already signed into, instead
# of a BYOK model key: claude | codex. Empty means BYOK, which stays the default.
#
# SELF-HOSTED ONLY, and this is a licence boundary rather than a preference. The
# CLI is authenticated as ONE HUMAN under a personal subscription that covers
# that human's own use. Billing other people's agent runs to it breaches those
# terms and gets the account terminated, so setting this with
# TREVRA_DEPLOYMENT_MODE=hosted refuses to start.
#
# What it does: spawns `claude -p` / `codex exec` per run with Trevra's own MCP
# server (src/mcp/server.ts) as its ONLY tool surface -- the same tools the BYOK
# agent gets. Bash, Write and the other built-in CLI tools are removed, because
# the agent reads attacker-influenced text by design and none of its tools may
# execute anything (see src/server/agent/loop.ts).
#
# The child gets a single-run scoped token, written to a 0600 file and revoked
# when the run ends, and its environment is stripped of ANTHROPIC_API_KEY,
# OPENAI_API_KEY and DATABASE_URL -- spending the subscription is the whole
# point, and a stray key in your shell would quietly bill the thing you asked
# to avoid.
#
# The run ledger, the kill switch and the monthly budget all still apply. A
# subscription costs no marginal dollars, so the budget's cents are notional
# here -- it is still the runaway guard, so raise the cap in Setup rather than
# expecting it not to fire.
TREVRA_AGENT_CLI=

# Path to the CLI if it is not on PATH as `claude` / `codex`.
TREVRA_AGENT_CLI_BIN=

# Passed through to the CLI's own --model. Empty means the CLI's default. Use a
# name the budget's price table knows (e.g. claude-sonnet-4-5) if you want the
# ledger's cost estimates to mean anything.
TREVRA_AGENT_CLI_MODEL=

# argv for the MCP bridge the CLI spawns. Empty is correct: it is derived from
# the running build. Set it only if you relocated dist-server.
TREVRA_AGENT_CLI_MCP_COMMAND=

# HOW THE CLI GETS YOUR SUBSCRIPTION. Pick one; leave both empty only when the
# worker runs on a host where you already ran the CLI's interactive login as the
# same OS user, because then the inherited $HOME is the credential.
#
#   A token -- the one that works in a container, where there is no browser to
#   log in with and no ~/.claude to read:
#
#     claude   run `claude setup-token` on your laptop and paste the result
#     codex    copy the ChatGPT access token out of ~/.codex/auth.json
#
#   Trevra never mints, refreshes or inspects it: it hands the string to the
#   child under the name that CLI expects (CLAUDE_CODE_OAUTH_TOKEN, or a
#   throwaway CODEX_HOME logged in from stdin) and forgets it. It is never in
#   argv, never in a prompt, and never in the run ledger.
TREVRA_AGENT_CLI_OAUTH_TOKEN=

#   Or a directory, if you would rather bind-mount ~/.claude / ~/.codex into the
#   container than copy a token out. This becomes the child's $HOME.
TREVRA_AGENT_CLI_HOME=

# Reddit research is authorized and refreshed by Nango. Create this provider
# configuration in Nango; Trevra stores only the returned connection reference.
NANGO_REDDIT_INTEGRATION=trevra-reddit
