TREVRA_DB_PASSWORD=trevra-local-password
# Dedicated high host ports to avoid collisions with other local stacks.
TREVRA_DB_PORT=45432
TREVRA_WEB_PORT=43173
TREVRA_API_PORT=43887
BETTER_AUTH_SECRET=development-only-trevra-secret-change-before-production
# Google OAuth web client. Redirect URI: http://localhost:43173/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional transactional SMTP. Port 465 uses implicit TLS; other ports require STARTTLS.
SMTP_SERVER=
SMTP_PORT=2525
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=Trevra
PUBLIC_SITE_URL=http://localhost:43173
PUBLIC_LEGAL_NAME=Trevra
PUBLIC_SUPPORT_EMAIL=support@trevra.local
SECURITY_CONTACT_EMAIL=security@trevra.local
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
MARKETING_HASH_SALT=development-marketing-salt-change-before-production
TRACTION_ADMIN_TOKEN=development-traction-token-change-before-production
TREVRA_AGENT_TOKEN_PEPPER=development-agent-token-pepper-change-before-production
# `npm run dev:setup` generates this once. Companion relay signing and local
# credential encryption both depend on it; do not commit the generated value.
TREVRA_SECRETS_KEY=
TREVRA_COMPANION_RELAY_URL=ws://127.0.0.1:8787
TREVRA_LINKEDIN_LOCAL=true
TREVRA_ORCHESTRATOR=postgres
TEMPORAL_ADDRESS=localhost:47233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=trevra-playbooks
TEMPORAL_TLS=false
TEMPORAL_API_KEY=
PUBLIC_REGISTRY_API_URL=http://localhost:43887
PUBLIC_REGISTRY_CORS_ORIGIN=http://localhost:43173
TREVRA_SANDBOX_GATEWAY_URL=
TREVRA_CONTAINER_RUNTIME=docker
TREVRA_WASI_RUNTIME=wasmtime
INDEXNOW_KEY=trevra-development-indexnow-key

NANGO_DB_PASSWORD=nango-local-password
NANGO_DB_PORT=45433
NANGO_REDIS_PORT=46379
NANGO_API_PORT=43003
NANGO_CONNECT_PORT=43009
# Generate once with: openssl rand -base64 32
NANGO_ENCRYPTION_KEY=uB4uY6dI5Zp2iYVg5m5V+M0r1fP9cS8yP0mT8wH9WkE=
NANGO_IMAGE_TAG=hosted
# After opening the Nango dashboard, create/copy the environment secret key here.
NANGO_API_KEY=
NANGO_WEBHOOK_SIGNING_KEY=

# CRM and prospecting integration ids. Every catalog entry falls back to the value shown here, so
# these only need setting when the integrations in your Nango environment are named differently.
# HubSpot and Attio use OAuth. Exa authenticates with an API key the operator types into the Nango
# Connect UI; the key is stored by Nango and never reaches a Trevra process. Apollo is deliberately
# not offered -- its terms forbid integrating the API with another product.
NANGO_HUBSPOT_INTEGRATION=trevra-hubspot
NANGO_ATTIO_INTEGRATION=trevra-attio
NANGO_EXA_INTEGRATION=trevra-exa
# Comma-separated sync function names. HubSpot and Attio are read-only: records flow into the ledger
# and nothing is written back. Exa is queried on demand and has no scheduled sync.
NANGO_SYNCS_HUBSPOT=trevra-opportunities,trevra-messages
NANGO_SYNCS_ATTIO=trevra-opportunities,trevra-messages
NANGO_SYNCS_APOLLO=
NANGO_SYNCS_EXA=

OPENAI_API_KEY=
OPENAI_EXTRACTION_MODEL=gpt-5-mini
