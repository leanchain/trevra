# Copy to .env.oracle on the box (chmod 600) and fill in.
#
# Every value marked REQUIRED is enforced at boot by validateEnvironment() in
# src/server/config.ts -- the process exits with a list of problems rather than
# starting in a half-configured state. Run ./gen-secrets.sh to produce the
# random ones.

# --- Infrastructure -----------------------------------------------------
# REQUIRED. Postgres superuser password; consumed by compose.oracle.yml to
# build DATABASE_URL. Do not set DATABASE_URL here, compose derives it.
TREVRA_DB_PASSWORD=

# REQUIRED. From `cloudflared tunnel create trevra` (or the Zero Trust
# dashboard). Route app.usetrevra.com to http://trevra:8080 Cloudflare-side.
CLOUDFLARE_TUNNEL_TOKEN=

# --- Public identity ----------------------------------------------------
# REQUIRED. Must be HTTPS in production.
PUBLIC_SITE_URL=https://usetrevra.com
APP_ORIGIN=https://app.usetrevra.com
BETTER_AUTH_URL=https://app.usetrevra.com

# REQUIRED, both must be valid addresses.
PUBLIC_SUPPORT_EMAIL=
SECURITY_CONTACT_EMAIL=
PUBLIC_LEGAL_NAME=Trevra

# --- Secrets (32+ chars each; gen-secrets.sh) ---------------------------
# REQUIRED, both must be valid addresses.
PUBLIC_SUPPORT_EMAIL=
SECURITY_CONTACT_EMAIL=
PUBLIC_LEGAL_NAME=Trevra

# Optional transactional SMTP for team invitations. Port 465 uses implicit TLS;
# other ports require STARTTLS. Keep these values only in the instance-local
# .env.oracle, never in source control.
SMTP_SERVER=
SMTP_PORT=2525
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=Trevra
# --- Auth ---------------------------------------------------------------
# Optional, but both or neither -- config.ts rejects one without the other.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Nango --------------------------------------------------------------
# REQUIRED both. NANGO_HOST points at Nango Cloud by default; switch it to
# http://nango-server:3003 only if you run the compose.oracle.nango.yml overlay
# (see the arm64 emulation warning in that file).
NANGO_HOST=https://api.nango.dev
NANGO_API_KEY=
NANGO_WEBHOOK_SIGNING_KEY=

# Only used by the self-hosted overlay.
# NANGO_DB_PASSWORD=
# NANGO_ENCRYPTION_KEY=            # 32-byte base64: openssl rand -base64 32
# NANGO_PUBLIC_SERVER_URL=https://nango.usetrevra.com
# NANGO_PUBLIC_CONNECT_URL=https://connect.usetrevra.com

# --- Runtime ------------------------------------------------------------
# Oracle is the hosted, multi-tenant deployment. Compose also pins this value so
# a missing line cannot silently enable the permissive single-operator path.
TREVRA_DEPLOYMENT_MODE=hosted

# REQUIRED. Encrypts tenant BYOK keys, LinkedIn credentials/sessions and
# credential-bearing per-seat proxy URLs. Generate with gen-secrets.sh.
TREVRA_SECRETS_KEY=
# Rotation only: set to the key you are replacing, then remove after custody
# reporting says the re-seal is complete.
TREVRA_SECRETS_KEY_PREVIOUS=

# REQUIRED true in public production.
COOKIE_SECURE=true

# Must be absent or false in production; config.ts refuses to start otherwise.
ALLOW_DEMO_AUTH=false
ALLOW_SIMULATED_EXECUTION=false

# 60000 (the default) polls Postgres every minute. That is fine here because
# the database is local and always on -- unlike a metered serverless Postgres,
# where the same default burns the monthly compute allowance. Range: 10000-3600000.
AUTOMATION_INTERVAL_MS=60000

TREVRA_ORCHESTRATOR=postgres
# compose.micro-db.yml caps the micro DB at max_connections=20 -- there is no
# RAM on an E2.1.Micro for more. Both api and worker read DATABASE_POOL_MAX
# from this one file, and the api also opens AUTH_DATABASE_POOL_MAX (Better
# Auth's own pool, default 5 if unset): steady-state ceiling is
# api(DATABASE_POOL_MAX+AUTH_DATABASE_POOL_MAX) + worker(DATABASE_POOL_MAX).
# The old 10/unset pair summed to 21 -- over the cap before pg_dump or a
# migration job asked for a connection of their own, so a routine deploy's
# pre-migration backup failed with "sorry, too many clients already" even
# though nothing had leaked. 5+3 sums to 13, leaving 7 slots of headroom.
DATABASE_POOL_MAX=5
AUTH_DATABASE_POOL_MAX=3
DATABASE_AUTO_MIGRATE=false

# Release automation writes this non-secret value on the app VM immediately
# before a guarded rollout. The relay advertises exactly this companion package
# and existing companions self-update before accepting new browser work.
TREVRA_COMPANION_RELEASE_VERSION=0.2.2

# Hosted LinkedIn uses the paired member-computer companion by default. The
# Oracle compose files wire its private reverse-CDP relay internally; users pair
# with `npx trevra linkedin` and no variable is needed here.
# TREVRA_BROWSER_PROVIDER=remote
# TREVRA_BROWSER_CDP_URL=wss://browser.example/connect?token={apiKey}&proxy={proxyUrl}
# TREVRA_BROWSER_API_KEY=
# TREVRA_BROWSER_CONNECT=cdp
# TREVRA_BROWSER_HEADERS={}
# TREVRA_BROWSER_LABEL=

# --- Optional -----------------------------------------------------------
# OPENAI_API_KEY=
# OPENAI_EXTRACTION_MODEL=gpt-5-mini
# STRIPE_SECRET_KEY=               # requires STRIPE_WEBHOOK_SECRET alongside it
# STRIPE_WEBHOOK_SECRET=
