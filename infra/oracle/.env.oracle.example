# Copy to .env.oracle on the box (chmod 600) and fill in.
#
# Every value marked REQUIRED is enforced at boot by validateEnvironment() in
# src/server/config.ts -- the process exits with a list of problems rather than
# starting in a half-configured state. Run ./gen-secrets.sh to produce the
# random ones.

# --- Infrastructure -----------------------------------------------------
# REQUIRED. Postgres superuser password; consumed by compose.oracle.yml to
# build DATABASE_URL. Do not set DATABASE_URL here, compose derives it.
TREVRA_DB_PASSWORD=

# REQUIRED. From `cloudflared tunnel create trevra` (or the Zero Trust
# dashboard). Route app.usetrevra.com to http://trevra:8080 Cloudflare-side.
CLOUDFLARE_TUNNEL_TOKEN=

# --- Public identity ----------------------------------------------------
# REQUIRED. Must be HTTPS in production.
PUBLIC_SITE_URL=https://usetrevra.com
APP_ORIGIN=https://app.usetrevra.com
BETTER_AUTH_URL=https://app.usetrevra.com

# REQUIRED, both must be valid addresses.
PUBLIC_SUPPORT_EMAIL=
SECURITY_CONTACT_EMAIL=
PUBLIC_LEGAL_NAME=Trevra

# --- Secrets (32+ chars each; gen-secrets.sh) ---------------------------
BETTER_AUTH_SECRET=
MARKETING_HASH_SALT=
TRACTION_ADMIN_TOKEN=
TREVRA_AGENT_TOKEN_PEPPER=

# REQUIRED. 8-128 URL-safe characters ([A-Za-z0-9._-]).
INDEXNOW_KEY=

# --- Auth ---------------------------------------------------------------
# Optional, but both or neither -- config.ts rejects one without the other.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Nango --------------------------------------------------------------
# REQUIRED both. NANGO_HOST points at Nango Cloud by default; switch it to
# http://nango-server:3003 only if you run the compose.oracle.nango.yml overlay
# (see the arm64 emulation warning in that file).
NANGO_HOST=https://api.nango.dev
NANGO_API_KEY=
NANGO_WEBHOOK_SIGNING_KEY=

# Only used by the self-hosted overlay.
# NANGO_DB_PASSWORD=
# NANGO_ENCRYPTION_KEY=            # 32-byte base64: openssl rand -base64 32
# NANGO_PUBLIC_SERVER_URL=https://nango.usetrevra.com
# NANGO_PUBLIC_CONNECT_URL=https://connect.usetrevra.com

# --- Runtime ------------------------------------------------------------
# REQUIRED true in production.
COOKIE_SECURE=true

# Must be absent or false in production; config.ts refuses to start otherwise.
ALLOW_DEMO_AUTH=false
ALLOW_SIMULATED_EXECUTION=false

# 60000 (the default) polls Postgres every minute. That is fine here because
# the database is local and always on -- unlike a metered serverless Postgres,
# where the same default burns the monthly compute allowance. Range: 10000-3600000.
AUTOMATION_INTERVAL_MS=60000

TREVRA_ORCHESTRATOR=postgres
DATABASE_POOL_MAX=10

# --- Optional -----------------------------------------------------------
# OPENAI_API_KEY=
# OPENAI_EXTRACTION_MODEL=gpt-5-mini
# STRIPE_SECRET_KEY=               # requires STRIPE_WEBHOOK_SECRET alongside it
# STRIPE_WEBHOOK_SECRET=
