project_id    = "your-gcp-project"
region        = "europe-west6"
image         = "europe-west6-docker.pkg.dev/your-gcp-project/trevra/trevra:latest"
app_origin    = "https://app.example.com"
better_auth_url = "https://app.example.com"
nango_host       = "https://nango-api.example.com"
legal_name       = "Trevra"
support_email    = "support@example.com"
alert_email      = "founder@example.com"
security_contact_email = "security@example.com"
google_site_verification = ""
bing_site_verification   = ""

# Prefer TF_VAR_* environment variables instead of storing OAuth and provider secrets here.
google_client_id          = "your-client-id.apps.googleusercontent.com"
google_client_secret      = "replace-me"
nango_api_key             = "replace-me"
nango_webhook_signing_key = "replace-me"
