{
  "name": "trevra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c auto \"tsx watch src/server/index.ts\" \"vite --host 0.0.0.0\"",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "start": "NODE_ENV=production node dist-server/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/test-with-postgres.ts",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "check": "npm test && npm run build",
    "db:reset": "tsx scripts/reset-db.ts",
    "db:migrate-sqlite": "tsx scripts/migrate-sqlite-to-postgres.ts"
  },
  "dependencies": {
    "@nangohq/frontend": "^0.71.2",
    "@nangohq/node": "^0.71.2",
    "better-auth": "^1.6.24",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^7.0.1",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.12.0",
    "multer": "^2.2.0",
    "openai": "^6.48.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stripe": "^22.3.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.0.4",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^9.1.2",
    "supertest": "^7.0.0",
    "testcontainers": "^12.0.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
