# Store this file outside source control with chmod 600.
NANGO_CLOUD_SQL_INSTANCE=project:region:nango-postgres
NANGO_DB_USER=nango
NANGO_DB_PASSWORD=replace-me
NANGO_DB_NAME=nango
NANGO_REDIS_HOST=10.0.0.10
NANGO_REDIS_PORT=6379
NANGO_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32
