NANGO_PUBLIC_SERVER_URL=https://nango-api.example.com
NANGO_PUBLIC_CONNECT_URL=https://nango-connect.example.com
NANGO_DASHBOARD_USERNAME=admin
NANGO_DASHBOARD_PASSWORD=replace-me
FLAG_AUTH_ENABLED=true
LOG_LEVEL=info
