# Copy to .env.selfhost or run ./scripts/selfhost-init.sh.
# .env.selfhost is gitignored and must stay chmod 600.
TREVRA_SELFHOST_PORT=43900
TREVRA_DB_PASSWORD=replace-with-random-hex

# Single-operator production is intentionally loopback-only. For a remotely
# reachable deployment, use HTTPS and COOKIE_SECURE=true instead.
APP_ORIGIN=http://localhost:43900
BETTER_AUTH_URL=http://localhost:43900
PUBLIC_SITE_URL=http://localhost:43900
COOKIE_SECURE=false
TREVRA_DEPLOYMENT_MODE=local

BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
MARKETING_HASH_SALT=replace-with-at-least-32-random-characters
TRACTION_ADMIN_TOKEN=replace-with-at-least-32-random-characters
TREVRA_AGENT_TOKEN_PEPPER=replace-with-at-least-32-random-characters
TREVRA_SECRETS_KEY=replace-with-32-bytes-base64
INDEXNOW_KEY=replace-with-url-safe-key
INGEST_API_KEY=replace-with-a-long-random-value

PUBLIC_LEGAL_NAME=Trevra
PUBLIC_SUPPORT_EMAIL=support@trevra.local
SECURITY_CONTACT_EMAIL=security@trevra.local
PUBLIC_REGISTRY_API_URL=http://localhost:43900
PUBLIC_REGISTRY_CORS_ORIGIN=http://localhost:43900

TREVRA_ORCHESTRATOR=postgres
ALLOW_DEMO_AUTH=false
ALLOW_SIMULATED_EXECUTION=false

# Browser automation is deliberately off inside the hardened production
# containers. Enable/run a local browser worker explicitly when you are ready to
# attach your own account and profile.
TREVRA_LINKEDIN_LOCAL=false
TREVRA_REDDIT_LOCAL=false
TREVRA_LINKEDIN_LEAD_SOURCING=false

# Optional integrations. Leave both empty to run the core product without Nango.
# If either is set in production, config validation requires the pair.
NANGO_API_KEY=
NANGO_WEBHOOK_SIGNING_KEY=
NANGO_HOST=
NANGO_PUBLIC_SERVER_URL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OPENAI_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
TREVRA_SANDBOX_GATEWAY_URL=
TREVRA_SANDBOX_GATEWAY_TOKEN=
TREVRA_REMOTE_ACTION_ADAPTERS_JSON=[]
TREVRA_REMOTE_ACTION_ADAPTER_TOKEN=
# TREVRA_AGENT_CLI=claude  # or codex; omit entirely when disabled
TREVRA_AGENT_CLI_OAUTH_TOKEN=
TREVRA_AGENT_CLI_MODEL=
TREVRA_ALLOW_PRIVATE_MODEL_HOSTS=false
