{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "outDir": "dist-server",
    "noEmit": false,
    "isolatedModules": false,
    "declaration": false,
    "sourceMap": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/server/**/*.ts",
    "src/shared/**/*.ts",
    "src/agent/**/*.ts",
    "src/mcp/**/*.ts",
    "src/cli/**/*.ts",
    "src/sandbox-gateway/**/*.ts",
    "src/worker/**/*.ts"
  ],
  "exclude": [
    "src/**/*.test.ts"
  ]
}
